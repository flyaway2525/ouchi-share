rules_version = '2';

// ouchi-share のセキュリティルール
// - グループを作れるのは admins/{uid} に登録された Google ログインユーザーだけ
// - グループの中身を読み書きできるのはメンバーだけ（ゲストも編集可）
// - メンバー以外は、正しい招待コードを知っているときだけ自分をメンバーに追加できる
//
// 反映方法: firebase deploy --only firestore:rules（Firebase CLI。設定は firebase.json / .firebaserc）

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isGuestUser() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isAdmin() {
      return signedIn() && !isGuestUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isNonEmptyString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // ---- 許可リスト（コンソールからのみ編集） ----
    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, write: if false;
    }

    // ---- お知らせ ----
    function isValidNews(d) {
      return d.keys().hasOnly(['title', 'body', 'createdAt', 'createdBy', 'createdByName', 'official'])
        && (!('official' in d) || d.official is bool)
        && isNonEmptyString(d.title, 100)
        && d.body is string && d.body.size() <= 2000
        && d.createdBy == request.auth.uid
        && d.createdByName is string && d.createdByName.size() <= 40;
    }

    // 再アナウンス：変えてよいのは announcedAt / announcedBy / announcedByName だけ
    function isReannounce() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['announcedAt', 'announcedBy', 'announcedByName'])
        && request.resource.data.announcedBy == request.auth.uid
        && request.resource.data.announcedAt is int
        && request.resource.data.announcedByName is string && request.resource.data.announcedByName.size() <= 40;
    }

    // アプリからのお知らせ：ログインしている人は読める。書く・消す・再アナウンスは管理者だけ
    match /announcements/{newsId} {
      allow read: if signedIn();
      allow create: if isAdmin() && isValidNews(request.resource.data);
      allow update: if isAdmin() && isReannounce();
      allow delete: if isAdmin();
    }

    // お知らせの既読：本人だけ
    match /reads/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // 通知の宛先（端末ごとのトークン）と、受け取る種類の設定：本人だけ。
    // 通知を送る Cloudflare Workers はサービスアカウントで読むので、このルールの影響を受けない
    match /push/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ---- アプリ共通の設定（ログインボーナスのチケットの配布表など）：読むのはログインしている人、書くのは管理者 ----
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- プロフィールの全体の設定：本人だけ ----
    match /profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['icon', 'photo', 'title', 'colors', 'updatedAt'])
        && request.resource.data.icon is string && request.resource.data.icon.size() <= 16
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 60000))
        && request.resource.data.title is string && request.resource.data.title.size() <= 20
        && request.resource.data.colors is map && request.resource.data.colors.size() <= 3;
    }

    // ---- 最終アクセス時刻（オンライン表示用） ----
    match /presence/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['lastSeen', 'name', 'guest'])
        && request.resource.data.lastSeen == request.time
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.guest == isGuestUser();
      allow delete: if false;
    }

    // ---- ゲストの復旧ID ----
    // code（ドキュメント ID）自体が合言葉。code を知っていれば get できるが、一覧は本人とグループのオーナーだけ
    match /recovery/{code} {
      function groupOf(gid) {
        return get(/databases/$(database)/documents/groups/$(gid)).data;
      }

      allow get: if signedIn();
      allow list: if signedIn()
        && (resource.data.uid == request.auth.uid
          || groupOf(resource.data.groupId).members[request.auth.uid].role == 'owner');
      // ゲスト本人が自分の分を作るか、オーナーがグループのゲストの分を作る
      allow create: if signedIn()
        && code.size() == 12
        && request.resource.data.keys().hasOnly(['groupId', 'uid', 'name', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && ((isGuestUser()
              && request.resource.data.uid == request.auth.uid
              && request.auth.uid in groupOf(request.resource.data.groupId).memberIds)
          || (groupOf(request.resource.data.groupId).members[request.auth.uid].role == 'owner'
              && groupOf(request.resource.data.groupId).members[request.resource.data.uid].guest == true));
      allow update: if false;
      // 本人・オーナー、または引き継ぎ済み（元のゲストがもうメンバーでない）なら消せる
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid
          || groupOf(resource.data.groupId).members[request.auth.uid].role == 'owner'
          || !(resource.data.uid in groupOf(resource.data.groupId).members));
    }

    // ---- グループ ----
    match /groups/{groupId} {

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }

      function isOwner() {
        return isMember() && resource.data.members[request.auth.uid].role == 'owner';
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // メンバーが自分のメンバー情報（名前・ゲスト表示・最終アクセス時刻）だけを更新する
      function isOwnProfileUpdate() {
        let me = request.auth.uid;
        let before = resource.data.members[me];
        let after = request.resource.data.members[me];
        let keys = after.diff(before).affectedKeys();
        return changed().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me])
          && keys.hasOnly(['name', 'guest', 'lastSeen', 'icon', 'photo', 'title', 'colors', 'custom'])
          && (!keys.hasAny(['name']) || isNonEmptyString(after.name, 40))
          // プロフィール（アイコン・肩書き・色・グループだけの設定）
          && (!keys.hasAny(['icon']) || (after.icon is string && after.icon.size() <= 16))
          && (!keys.hasAny(['photo']) || (after.photo is string && after.photo.size() <= 60000))
          && (!keys.hasAny(['title']) || (after.title is string && after.title.size() <= 20))
          && (!keys.hasAny(['colors']) || (after.colors is map && after.colors.size() <= 3))
          && (!keys.hasAny(['custom']) || after.custom is map)
          && (!keys.hasAny(['guest']) || after.guest == isGuestUser())
          && (!keys.hasAny(['lastSeen']) || after.lastSeen == request.time);
      }

      // 招待リンクからの参加：自分だけを、正しい招待コード付きで追加する
      function isValidJoin() {
        let me = request.auth.uid;
        let entry = request.resource.data.members[me];
        return signedIn()
          && !(me in resource.data.memberIds)
          && changed().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([me].toSet())
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me])
          && entry.keys().hasOnly(['name', 'role', 'guest', 'joinedAt', 'inviteCode'])
          && entry.role == 'member'
          && entry.guest == isGuestUser()
          && isNonEmptyString(entry.name, 40)
          && entry.inviteCode == resource.data.inviteCode;
      }

      // 復旧ID による引き継ぎ：元のゲストのメンバー情報を消し、自分を同じ役割で加える
      // （memberIds からの元のゲストの削除は、次の isStaleRemoval で行う）
      function isValidRecovery() {
        let me = request.auth.uid;
        let entry = request.resource.data.members[me];
        let rec = get(/databases/$(database)/documents/recovery/$(entry.recoveryCode)).data;
        let old = rec.uid;
        return signedIn()
          && !(me in resource.data.memberIds)
          && changed().hasOnly(['memberIds', 'members'])
          && rec.groupId == groupId
          && old in resource.data.members
          && resource.data.members[old].guest == true
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([me].toSet())
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me, old])
          && !(old in request.resource.data.members)
          && entry.keys().hasOnly(['name', 'role', 'guest', 'joinedAt', 'recoveryCode'])
          && entry.role == resource.data.members[old].role
          && entry.guest == isGuestUser()
          && isNonEmptyString(entry.name, 40);
      }

      // メンバー情報が無くなった uid を memberIds から外す（追加はしない）
      function isStaleRemoval() {
        let before = resource.data.memberIds.toSet();
        let after = request.resource.data.memberIds.toSet();
        let removed = before.difference(after);
        return changed().hasOnly(['memberIds'])
          && after.difference(before).size() == 0
          && removed.size() > 0
          && resource.data.members.keys().toSet().intersection(removed).size() == 0;
      }

      // オーナーが、ほかのメンバー 1 人を管理者にする／外す（role を 'admin' / 'member' に変えるだけ）。
      // ルールでは変えた人の uid を取り出せないので、roleTarget に対象の uid を一緒に書いてもらう
      function isRoleChange() {
        let t = request.resource.data.roleTarget;
        return isOwner()
          && changed().hasOnly(['members', 'roleTarget'])
          && t is string && t != request.auth.uid && t in resource.data.members
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([t])
          && request.resource.data.members[t].diff(resource.data.members[t]).affectedKeys().hasOnly(['role'])
          && resource.data.members[t].role != 'owner'
          && request.resource.data.members[t].role in ['admin', 'member'];
      }

      // メンバーを外す（1 人だけ、memberIds と members の両方から消す）
      //   オーナーはほかの人を外せる（自分は外せない）。オーナー以外は自分だけ抜けられる
      function isMemberRemoval() {
        let me = request.auth.uid;
        let before = resource.data.memberIds.toSet();
        let after = request.resource.data.memberIds.toSet();
        let removed = before.difference(after);
        return changed().hasOnly(['memberIds', 'members'])
          && after.difference(before).size() == 0
          && removed.size() == 1
          && request.resource.data.members.diff(resource.data.members).affectedKeys() == removed
          && request.resource.data.members.keys().toSet().intersection(removed).size() == 0
          && ((isOwner() && !removed.hasAny([me]))
            || (removed.hasOnly([me]) && resource.data.members[me].role != 'owner'));
      }

      function isValidNewGroup() {
        let me = request.auth.uid;
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'createdAt', 'createdBy', 'inviteCode', 'memberIds', 'members'])
          && isNonEmptyString(d.name, 40)
          && d.createdBy == me
          && d.memberIds == [me]
          && d.members.keys().hasOnly([me])
          && d.members[me].role == 'owner'
          && d.inviteCode is string && d.inviteCode.size() >= 16;
      }

      allow get, list: if isMember();
      allow create: if isAdmin() && isValidNewGroup();
      allow update: if (isMember() && changed().hasOnly(['name']) && isNonEmptyString(request.resource.data.name, 40))
        || (isOwner() && changed().hasOnly(['inviteCode']) && request.resource.data.inviteCode.size() >= 16)
        || (isMember() && isOwnProfileUpdate())
        || (isMember() && isStaleRemoval())
        || (isMember() && isMemberRemoval())
        || isRoleChange()
        || isValidJoin()
        || isValidRecovery();
      allow delete: if isOwner();

      // ---- リスト（アイテムはリストのドキュメント内の items マップ） ----
      match /lists/{listId} {
        function isGroupMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }

        function isValidList(d) {
          return isNonEmptyString(d.title, 100)
            && d.type in ['checklist', 'inventory', 'schedule', 'money', 'wish']
            && d.items is map
            && (!('eventId' in d) || d.eventId == null || d.eventId is string);
        }

        allow read: if isGroupMember();
        allow create, update: if isGroupMember() && isValidList(request.resource.data);
        allow delete: if isGroupMember();
      }

      // ---- イベント（旅行など期間のある予定。日付は "YYYY-MM-DD"） ----
      match /events/{eventId} {
        function isGroupMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }

        function isDate(v) {
          return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        }

        function isValidEvent(d) {
          return d.keys().hasOnly(['title', 'emoji', 'startDate', 'endDate', 'participants', 'createdAt', 'createdBy'])
            && isNonEmptyString(d.title, 60)
            && d.emoji is string && d.emoji.size() <= 16
            && isDate(d.startDate) && isDate(d.endDate)
            && d.startDate <= d.endDate
            && (!('participants' in d) || (d.participants is list && d.participants.size() <= 100));
        }

        allow read: if isGroupMember();
        allow create, update: if isGroupMember() && isValidEvent(request.resource.data);
        allow delete: if isGroupMember();
      }

      // ---- グループのお知らせ：メンバーなら誰でも書ける。消せるのは書いた本人とオーナー ----
      match /announcements/{newsId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function isGroupMember() {
          return signedIn() && request.auth.uid in groupData().memberIds;
        }

        function isManager() {
          return groupData().members[request.auth.uid].role in ['owner', 'admin'];
        }

        // 管理者お知らせ（official: true）は、グループのオーナー・管理者だけが書ける・再通知できる・消せる
        function isOfficial(d) {
          return 'official' in d && d.official == true;
        }

        allow read: if isGroupMember();
        allow create: if isGroupMember() && isValidNews(request.resource.data)
          && (!isOfficial(request.resource.data) || isManager());
        // 再アナウンスと削除：ふつうのお知らせは書いた本人かオーナー・管理者、管理者お知らせはオーナー・管理者だけ
        allow update: if isGroupMember() && isReannounce()
          && (isManager() || (!isOfficial(resource.data) && resource.data.createdBy == request.auth.uid));
        allow delete: if isGroupMember()
          && (isManager() || (!isOfficial(resource.data) && resource.data.createdBy == request.auth.uid));
      }

      // ---- 写真（欲しいものリストなど）。縮小した JPEG を data URL の文字列で 1 枚 1 ドキュメント ----
      match /bonus/{userId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function isGroupMember() {
          return signedIn() && request.auth.uid in groupData().memberIds;
        }

        // ログインボーナス（スタンプ集め）：メンバーはみんなの記録を読める。書けるのは本人だけ。消すのは本人かオーナー（グループの削除）
        allow read: if isGroupMember();
        allow create, update: if isGroupMember() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['lastDate', 'streak', 'total', 'stamps', 'lastStamp', 'month', 'monthDays', 'tickets', 'updatedAt'])
          && request.resource.data.lastDate is string && request.resource.data.lastDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.streak is int && request.resource.data.total is int
          && request.resource.data.stamps is map && request.resource.data.stamps.size() <= 300
          && (!('tickets' in request.resource.data) || request.resource.data.tickets is map);
        allow delete: if isGroupMember() && (request.auth.uid == userId || groupData().members[request.auth.uid].role in ['owner', 'admin']);
      }

      // ---- ごほうび（チケットで交換）：メンバーは見られる。登録・変更・削除はオーナーと管理者 ----
      match /rewards/{rewardId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function isOwner() {
          return signedIn() && request.auth.uid in groupData().memberIds && groupData().members[request.auth.uid].role in ['owner', 'admin'];
        }

        allow read: if signedIn() && request.auth.uid in groupData().memberIds;
        allow create, update: if isOwner()
          && request.resource.data.keys().hasOnly(['title', 'emoji', 'ticket', 'count', 'createdAt'])
          && isNonEmptyString(request.resource.data.title, 40)
          && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 16
          && request.resource.data.ticket in ['bronze', 'silver', 'gold']
          && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 99;
        allow delete: if isOwner();
      }

      // ---- 交換・換金の記録：メンバーは見られる。交換した本人が作る。「済み」にする・消すのはオーナーと管理者 ----
      match /redemptions/{logId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function isGroupMember() {
          return signedIn() && request.auth.uid in groupData().memberIds;
        }

        function isOwner() {
          return isGroupMember() && groupData().members[request.auth.uid].role in ['owner', 'admin'];
        }

        allow read: if isGroupMember();
        allow create: if isGroupMember() && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'title', 'emoji', 'ticket', 'count', 'at', 'done', 'kind', 'yen'])
          && request.resource.data.done == false;
        allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done']);
        allow delete: if isOwner();
      }

      // ---- グループの設定（チケットの両替・換金のレート）：メンバーは見られる。変えるのはオーナーと管理者 ----
      // settings/tickets = { upgrade: { silver: ブロンズ何枚で 1 枚, gold: シルバー何枚で 1 枚 }, yen: { bronze, silver, gold }（1 枚の円）, updatedAt }
      match /settings/{docId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        allow read: if signedIn() && request.auth.uid in groupData().memberIds;
        allow write: if signedIn() && request.auth.uid in groupData().memberIds
          && groupData().members[request.auth.uid].role in ['owner', 'admin']
          && request.resource.data.keys().hasOnly(['upgrade', 'yen', 'updatedAt'])
          && request.resource.data.upgrade is map && request.resource.data.yen is map;
      }

      match /photos/{photoId} {
        function isGroupMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }

        allow read: if isGroupMember();
        allow create: if isGroupMember()
          && request.resource.data.keys().hasOnly(['data', 'createdAt', 'createdBy'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 900000;
        allow update: if false;
        allow delete: if isGroupMember();
      }

      // ---- 普段の予定（歯医者など。カレンダーに表示） ----
      match /plans/{planId} {
        function isGroupMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }

        function isValidPlan(d) {
          return d.keys().hasOnly(['title', 'date', 'endDate', 'start', 'duration', 'place', 'memo', 'links', 'participants', 'createdAt', 'createdBy'])
            && isNonEmptyString(d.title, 100)
            && (d.date == null || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            // 何日か続く予定の終わりの日（開始日より後）
            && (!('endDate' in d) || d.endDate == null
              || (d.date is string && d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.endDate > d.date))
            && (d.start == null || (d.start is string && d.start.matches('^[0-9]{2}:[0-9]{2}$')))
            && (!('participants' in d) || (d.participants is list && d.participants.size() <= 100))
            && (!('links' in d) || (d.links is list && d.links.size() <= 20));
        }

        allow read: if isGroupMember();
        allow create, update: if isGroupMember() && isValidPlan(request.resource.data);
        allow delete: if isGroupMember();
      }

      // ---- 日記（どの項目も空でよい。メンバーなら誰でも読み書きできる） ----
      match /diary/{entryId} {
        function isGroupMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }

        function isValidDiary(d) {
          return d.keys().hasOnly(['title', 'at', 'members', 'tags', 'body', 'createdAt', 'createdBy', 'updatedAt'])
            && d.title is string && d.title.size() <= 100
            // 日付だけ・時刻まで・0.01 秒まで（空ならなし）
            && d.at is string
            && (d.at == '' || d.at.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}([.][0-9]{1,2})?)?)?$'))
            && d.members is list && d.members.size() <= 100
            && d.tags is list && d.tags.size() <= 50
            && d.body is string && d.body.size() <= 10000;
        }

        allow read: if isGroupMember();
        allow create: if isGroupMember() && isValidDiary(request.resource.data) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isGroupMember() && isValidDiary(request.resource.data) && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isGroupMember();
      }

      // ---- 日記のタグ（自由に作れる） ----
      match /diaryTags/{tagId} {
        function isGroupMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }

        allow read: if isGroupMember();
        allow create, update: if isGroupMember()
          && request.resource.data.keys().hasOnly(['name', 'createdAt', 'createdBy'])
          && isNonEmptyString(request.resource.data.name, 30);
        allow delete: if isGroupMember();
      }
    }
  }
}
